{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LexiShift Semantic Admit Batch Response",
  "description": "Planning-only schema for future helper-side semantic admission batch responses returned to runtime surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pair",
    "profile_id",
    "decision_policy_id",
    "fallback_policy",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "pair": {
      "type": "string",
      "pattern": "^[a-z]{2,3}-[a-z]{2,3}$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "fallback_policy": {
      "type": "string",
      "enum": [
        "legacy_on_unavailable",
        "abstain_on_unavailable",
        "soft_affordance_on_unavailable"
      ]
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/decisionRecord"
      }
    }
  },
  "definitions": {
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "match_id",
        "decision",
        "decision_source",
        "reason_codes"
      ],
      "properties": {
        "match_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "replace",
            "soft_affordance",
            "abstain"
          ]
        },
        "decision_source": {
          "type": "string",
          "enum": [
            "policy",
            "fallback_policy"
          ]
        },
        "reason_codes": {
          "$ref": "#/definitions/reasonCodes"
        },
        "trigger_id": {
          "type": "string",
          "minLength": 1
        },
        "sense_id": {
          "type": "string",
          "minLength": 1
        },
        "competition_set_id": {
          "type": "string",
          "minLength": 1
        },
        "phrase_set_id": {
          "type": "string",
          "minLength": 1
        },
        "selection_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "context_view_id": {
          "type": "string",
          "minLength": 1
        },
        "active_score": {
          "type": "number"
        },
        "top_shadow_score": {
          "type": "number"
        },
        "score_margin": {
          "type": "number"
        },
        "shadow_winner_sense_id": {
          "type": "string",
          "minLength": 1
        },
        "phrase_preempted": {
          "type": "boolean"
        }
      }
    }
  }
}
