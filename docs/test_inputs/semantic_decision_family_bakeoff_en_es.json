{
  "schema_version": 1,
  "matrix_id": "en_es_semantic_decision_family_bakeoff_v1",
  "description": "No-spend offline bakeoff for structurally similar active-vs-shadow scalar decision families. Evidence, scorer, aggregation, context, and phrase handling are held fixed so each family gets a fair threshold sweep without trampling source or representation results.",
  "include_case_results": false,
  "dataset_path": "docs/test_inputs/semantic_routing_cases/en_es_sentence_veto_v10.json",
  "defaults": {
    "scorer_id": "tfidf_cosine",
    "context_view": "masked_sentence",
    "sense_representation": "all_evidence_text",
    "aggregation_rule": "single_concatenated_text",
    "phrase_handling": "phrase_override",
    "window_tokens": 4,
    "mask_token": "___",
    "min_active_score": 0.0,
    "min_margin": 0.0,
    "ratio_threshold": 1.0,
    "softmax_threshold": 0.5,
    "softmax_temperature": 8.0,
    "pairwise_min_win_rate": 0.75,
    "top_k": 2,
    "phrase_guard_pos_scope": "family_all",
    "evidence_control": "normal",
    "split_modulo": 4,
    "locked_eval_remainders": [
      0
    ]
  },
