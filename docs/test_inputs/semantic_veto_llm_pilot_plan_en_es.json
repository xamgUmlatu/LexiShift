    "source_evidence_promotion": "none"
  },
  "acceptance_context": {
    "positive_allow_rate_min": 0.8,
    "negative_abstain_rate_min": 0.5,
    "lane_role": "research_eval_expansion",
    "promotion_dependency": "Rows admitted here must be scored in product-quality and stress lanes before any runtime promotion claim."
  },
  "flow_steps": [
    {
      "step_id": "freeze_candidate",
      "required": true,
      "description": "Record the current shared veto-only candidate before generation."
    },
    {
      "step_id": "select_pilot_families",
      "required": true,
      "description": "Choose breadth families before seeing generated rows."
    },
    {
      "step_id": "generate_rows",
      "required": false,
      "blocked_until_preflight_passes": true,
      "description": "Generate rows only after this no-spend plan and admission contract pass."
    },
    {
      "step_id": "admission_filter",
      "required": true,
      "description": "Reject rows with leakage, missing context, broken labels, duplicates, or contract gaps."
    },
    {
      "step_id": "split_discovery_locked_eval",
      "required": true,
      "description": "Assign admitted rows deterministically before any threshold tuning."
    },
    {
      "step_id": "score_candidate",
      "required": true,
      "description": "Score admitted rows with the frozen candidate and current product metrics."
    },
    {
      "step_id": "expand_or_diagnose",
      "required": true,
      "description": "Only expand, tune, or diagnose after discovery and locked-eval outputs stay separate."
    }
  ],
  "split_policy": {
    "method": "sha256_row_id_modulo",
    "modulo": 4,
    "locked_eval_remainders": [
      0
    ],
    "threshold_tuning_allowed_on_locked_eval": false
  },
