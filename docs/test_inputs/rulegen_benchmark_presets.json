{
  "version": 1,
  "presets": {
    "en_es_canonical_matrix": {
      "description": "Current canonical en-es benchmark matrix used for latest quality artifacts and day-to-day rulegen comparisons.",
      "args": [
        "--pairs",
        "en-es",
        "--max-definitions-values",
        "3",
        "--max-rules-values",
        "none",
        "--confidence-threshold-values",
        "0.0",
        "--semantic-demotion-scale-values",
        "1.0",
        "--include-variants-values",
        "true,false",
        "--pos-scoring-values",
        "true,false",
        "--pos-exact-values",
        "1.0",
        "--pos-compatible-values",
        "0.5",
        "--score-weight-dict-values",
        "0.6",
        "--score-weight-frequency-values",
        "0.2",
        "--score-weight-pos-values",
        "0.1",
        "--score-weight-variant-values",
        "0.1",
        "--score-weight-phrase-values",
        "0.1",
        "--score-weight-embedding-values",
        "0.2",
        "--reverse-check-enabled-values",
        "false,true",
        "--reverse-check-match-bonus-values",
        "0.2",
        "--reverse-check-near-bonus-values",
        "0.1",
        "--reverse-check-near-rank-max-values",
        "2",
        "--reverse-check-far-hit-penalty-values",
        "0.0",
        "--reverse-check-miss-penalty-values",
        "0.2",
        "--reverse-check-exact-hit-ambiguity-threshold-values",
        "0",
        "--reverse-check-exact-hit-ambiguity-penalty-values",
        "0.0",
        "--reverse-check-exact-hit-specificity-bonus-values",
        "0.0,0.1,0.2",
        "--kaikki-policy-live-demotion-values",
        "false,true",
        "--kaikki-policy-risk-family-sets",
        "math_geometry+government_law+hunting_fishing_tools+register_region+abbreviation_ellipsis_formof",
        "--max-configurations",
        "500"
      ]
    },
    "en_es_policy_hypothesis_matrix": {
      "description": "Compact en-es hypothesis matrix for Kaikki live-demotion and reverse-check experiments while keeping extraction fixed.",
      "args": [
        "--pairs",
        "en-es",
        "--include-variants-values",
        "false",
        "--pos-scoring-values",
        "true",
        "--reverse-check-enabled-values",
        "false,true",
        "--reverse-check-exact-hit-specificity-bonus-values",
        "0.0,0.1,0.2",
        "--kaikki-policy-live-demotion-values",
        "false,true",
        "--kaikki-policy-risk-family-sets",
        "math_geometry+government_law+hunting_fishing_tools+register_region;math_geometry+government_law+hunting_fishing_tools+register_region+abbreviation_ellipsis_formof",
        "--max-configurations",
        "64"
      ]
    }
  }
}
