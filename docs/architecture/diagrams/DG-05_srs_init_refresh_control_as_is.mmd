  %% DG-05 [AS-IS] SRS initialize/refresh control flow
  %% Last verified: 2026-02-19
  %% Sources:
  %% - docs/architecture/native_messaging_design.md
  %% - docs/architecture/native_messaging_checklist.md
  %% - docs/architecture/chrome_extension_technical.md

  ACTION["Options SRS action (initialize / refresh / diagnostics)"] --> CTL["srs actions controller/workflows"]
  CTL --> PAYLOAD["Build payload (profile_id + pair + sizing context)"]
  PAYLOAD --> SW["Service worker native bridge"]
  SW --> HOST["Native messaging host"]
  HOST --> CMD["Helper commands: srs_plan_set / srs_initialize / srs_refresh / get_snapshot / get_ruleset"]

  CMD --> OUT_STORE["Write helper profile artifacts (srs_store/status/signal_queue)"]
  CMD --> OUT_RULES["Publish helper ruleset + snapshot"]

  OUT_RULES --> RUNTIME["Content runtime helper rules fetch (profile_id + pair)"]
  RUNTIME --> APPLY["Apply updated rules in replacement pipeline"]
