  %% DG-01 [AS-IS] Data ownership + storage layout
  %% Last verified: 2026-02-19
  %% Sources:
  %% - docs/architecture/chrome_extension_technical.md
  %% - docs/architecture/extension_system_map.md
  %% - docs/architecture/native_messaging_design.md
  %% - docs/srs/srs_schema.md

  subgraph EXT["Chrome Extension"]
    subgraph STORE["chrome.storage.local"]
      K1["srsProfiles.<profile_id>.* (authoritative extension profile scope)"]
      K2["srsProfileId / srsSelectedProfileId (selected profile mirrors)"]
      K3["srsStore (local SRS item state)"]
      K4["srsFeedbackLog (feedback log)"]
      K5["srsExposureLog (telemetry log, includes URL field for now)"]
      K6["helperFeedbackSyncQueue/Lock/Dropped (retry queue state)"]
    end
    IDB["IndexedDB: profile_media_store (profile background blobs)"]
  end

  subgraph BG["Service Worker / Native Bridge"]
    NM["chrome.runtime.sendNativeMessage (single bridge boundary)"]
  end

  subgraph HELPER["LexiShift Helper (App Data Root)"]
    IN["Inputs: language_packs/, frequency_packs/, embeddings/, rulesets/, profiles/"]
    OUT1["srs/srs_settings.json"]
    OUT2["srs/profiles/<profile_id>/srs_store.json"]
    OUT3["srs/profiles/<profile_id>/srs_rulegen_snapshot_<pair>.json"]
    OUT4["srs/profiles/<profile_id>/srs_ruleset_<pair>.json"]
    OUT5["srs/profiles/<profile_id>/srs_status.json"]
    OUT6["srs/profiles/<profile_id>/srs_signal_queue.json"]
  end

  K4 -->|"queue feedback"| K6
  K6 -->|"flush via service worker"| NM
  NM -->|"record_feedback / helper commands"| OUT6
  NM -->|"initialize/refresh/rulegen publish"| OUT2
  NM -->|"snapshot/ruleset responses"| OUT3
  NM -->|"snapshot/ruleset responses"| OUT4
