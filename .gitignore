# --- Python / Byte-compiled ---
__pycache__/
*.py[cod]
*$py.class
*.profraw
.pytest_cache/
.venv
venv/
env/
build/
dist/
*.spec
!apps/gui/packaging/pyinstaller.spec
!scripts/build/
!scripts/build/*.py

# --- OS Generated ---
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# --- IDEs / Editors ---
.vscode/
.idea/
*.swp
*.swo

# --- GUI / Assets ---
# If you generate icons or temporary UI files via PySide6
*_rc.py
*_ui.py
!apps/gui/src/helper_ui.py
!apps/gui/tests/test_*_ui.py

# --- Browser Extension & BetterDiscord ---
# Ignore local node modules if you add them later
node_modules/
.chrome-extension-key.pem
*.log

# --- Project Specific ---
# Ignore the generated build/dist folders from your packaging scripts
/packaging/output/
/packaging/build/

# Ignore generated Jekyll/GitHub Pages build artifacts
docs/_site/
docs/.jekyll-cache/
docs/.sass-cache/
docs/.jekyll-metadata
docs/.bundle/
docs/vendor/bundle/
docs/test_outputs/landing_visual_mocks/

# Keep only reviewed Chrome Web Store deliverables; local captures and crop
# intermediates are reproducible working files.
/release-assets/chrome-web-store/screenshots/source/
/release-assets/chrome-web-store/screenshots/working/

# Ignore local test vocabulary exports (prevent leaking personal word lists)
TestVocabPool.json
local_test_*.json

# --- Environment / Secrets ---
.env
*.local
