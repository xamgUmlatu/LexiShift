{
  "name": "vocab-replacer",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "preflight:cws": "node dev/cws_preflight.js",
    "health:project": "node dev/check_project_health.js --advisory",
    "health:project:report": "node dev/check_project_health.js --advisory --json-output ../docs/test_outputs/project_health/project_health_latest.json",
    "health:project:baseline": "node dev/check_project_health.js --advisory --write-baseline ../docs/test_outputs/project_health/project_health_baseline.json",
    "health:project:changed": "node dev/check_project_health.js --changed-only --base-ref origin/main --baseline-json ../docs/test_outputs/project_health/project_health_baseline.json --fail-on-new --fail-on-regressions",
    "quality:rulegen:gate": "python3 testing/rulegen_quality_gate.py",
    "quality:rulegen:triage": "python3 testing/rulegen_benchmark_triage.py",
    "build:bd": "node betterdiscord_plugin/build_plugin.js",
    "watch:bd": "node betterdiscord_plugin/watch_plugin.js",
    "sync:bd": "node betterdiscord_plugin/sync_plugin.js",
    "build-and-sync:bd": "node betterdiscord_plugin/build_plugin.js && node betterdiscord_plugin/sync_plugin.js"
  }
}
