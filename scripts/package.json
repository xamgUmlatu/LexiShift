{
  "name": "vocab-replacer",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "check": "node dev/run_python.js dev/dev_workflow_check.py",
    "check:report": "node dev/run_python.js dev/dev_workflow_check.py --json-out ../docs/test_outputs/dev_workflow/check_latest.json",
    "check:report:ci": "node dev/run_python.js dev/dev_workflow_check.py --skip-windows-parity --json-out ../docs/test_outputs/dev_workflow/check_latest.json",
    "check:state": "node dev/run_python.js dev/feature_state_audit.py --compare-ref HEAD --json-out ../docs/test_outputs/dev_workflow/feature_state_audit_latest.json",
    "check:docs": "node dev/run_python.js dev/check_doc_references.py",
    "check:lp-profiles": "node dev/run_python.js dev/check_rulegen_lp_profiles.py",
    "check:lp-conformance": "node dev/run_python.js dev/check_rulegen_lp_conformance.py",
    "scaffold:rulegen:lp": "node dev/run_python.js dev/scaffold_rulegen_lp.py",
    "check:docs:report": "node dev/run_python.js dev/check_doc_references.py --json-out ../docs/test_outputs/dev_workflow/doc_references_latest.json",
    "check:changed": "node dev/run_python.js dev/dev_workflow_changed_check.py --base-ref origin/main",
    "check:changed:local": "node dev/run_python.js dev/dev_workflow_changed_check.py --scope local",
    "check:changed:report": "node dev/run_python.js dev/dev_workflow_changed_check.py --base-ref origin/main --json-out ../docs/test_outputs/dev_workflow/check_changed_latest.json",
    "check:changed:staged": "node dev/run_python.js dev/dev_workflow_changed_check.py --scope staged",
    "check:changed:strict-style": "node dev/run_python.js dev/dev_workflow_changed_check.py --base-ref origin/main --strict-style",
    "check:summary": "node dev/run_python.js dev/dev_workflow_summary.py --check-json ../docs/test_outputs/dev_workflow/check_latest.json --changed-json ../docs/test_outputs/dev_workflow/check_changed_latest.json --build-json ../docs/test_outputs/dev_workflow/build_latest.json --markdown-out ../docs/test_outputs/dev_workflow/summary_latest.md",
    "check:style": "node dev/run_python.js dev/dev_workflow_style_check.py",
    "check:style:report": "node dev/run_python.js dev/dev_workflow_style_check.py --json-out ../docs/test_outputs/dev_workflow/style_latest.json",
    "check:style:summary": "node dev/run_python.js dev/dev_workflow_style_summary.py --style-json ../docs/test_outputs/dev_workflow/style_latest.json --markdown-out ../docs/test_outputs/dev_workflow/style_summary_latest.md",
    "check:style:strict": "node dev/run_python.js dev/dev_workflow_style_check.py --strict",
    "check:windows:parity": "node dev/run_python.js dev/windows_parity_audit.py --json-out ../docs/test_outputs/dev_workflow/windows_parity_latest.json",
    "check:windows:parity:strict": "node dev/run_python.js dev/windows_parity_audit.py --strict --json-out ../docs/test_outputs/dev_workflow/windows_parity_latest.json",
    "check:windows:parity:summary": "node dev/run_python.js dev/windows_parity_summary.py --audit-json ../docs/test_outputs/dev_workflow/windows_parity_latest.json --markdown-out ../docs/test_outputs/dev_workflow/windows_parity_summary_latest.md",
    "inventory:experiments": "node dev/run_python.js dev/experiment_payload_retention_audit.py",
    "inventory:structure": "node dev/run_python.js dev/project_structure_inventory.py",
    "inventory:unnecessary": "node dev/run_python.js dev/generated_output_unnecessary_audit.py",
    "dev:srs-admission-lab": "node dev/run_python.js dev/srs_admission_lab_server.py",
    "preflight:cws": "node dev/cws_preflight.js",
    "build": "node dev/run_python.js dev/dev_workflow_build.py",
    "build:ci": "node dev/run_python.js dev/dev_workflow_build.py --ci-safe",
    "build:report": "node dev/run_python.js dev/dev_workflow_build.py --json-out ../docs/test_outputs/dev_workflow/build_latest.json",
    "build:ci:report": "node dev/run_python.js dev/dev_workflow_build.py --ci-safe --json-out ../docs/test_outputs/dev_workflow/build_ci_latest.json",
    "build:gui": "node dev/run_python.js build/gui_app.py --validate",
    "hooks:install": "node dev/run_python.js -m pre_commit install --install-hooks --config ../.pre-commit-config.yaml --hook-type pre-commit --hook-type pre-push",
    "hooks:run:pre-push": "node dev/run_python.js -m pre_commit run repo-safety-check --hook-stage pre-push --all-files",
    "health:project": "node dev/check_project_health.js --advisory",
    "health:project:report": "node dev/check_project_health.js --advisory --json-output ../docs/test_outputs/project_health/project_health_latest.json",
    "health:project:baseline": "node dev/check_project_health.js --advisory --write-baseline ../docs/test_outputs/project_health/project_health_baseline.json",
    "health:project:changed": "node dev/check_project_health.js --changed-only --base-ref origin/main --baseline-json ../docs/test_outputs/project_health/project_health_baseline.json --fail-on-new --fail-on-regressions --fail-on-new-warnings --fail-on-warning-regressions",
    "quality:rulegen:audit": "node dev/run_python.js testing/rulegen_pair_audit_cycle.py",
    "quality:rulegen:auto": "node dev/run_python.js testing/rulegen_auto_audit.py --base-ref origin/main",
    "quality:rulegen:en-de": "node dev/run_python.js testing/rulegen_pair_audit_cycle.py --pairs en-de --benchmark-preset en_de_canonical_matrix --quality-gate-pair-scope en-de --benchmark-json ../docs/test_outputs/rulegen_benchmark_en_de_latest.json --benchmark-markdown ../docs/test_outputs/rulegen_benchmark_en_de_latest.md --benchmark-html ../docs/test_outputs/rulegen_benchmark_en_de_latest.html --quality-gate-json ../docs/test_outputs/rulegen_quality_gate_en_de_latest.json --triage-json ../docs/test_outputs/rulegen_benchmark_triage_en_de_latest.json --triage-markdown ../docs/test_outputs/rulegen_benchmark_triage_en_de_latest.md",
    "quality:rulegen:en-de:summary": "node dev/run_python.js testing/rulegen_benchmark_summary.py --benchmark-json ../docs/test_outputs/rulegen_benchmark_en_de_latest.json --title \"Rulegen Benchmark (en-de latest)\" --markdown-out ../docs/test_outputs/rulegen_benchmark_en_de_summary_latest.md && node dev/run_python.js testing/rulegen_quality_gate_summary.py --gate-json ../docs/test_outputs/rulegen_quality_gate_en_de_latest.json --title \"Rulegen Quality Gate (en-de latest)\" --markdown-out ../docs/test_outputs/rulegen_quality_gate_en_de_summary_latest.md && node dev/run_python.js testing/rulegen_benchmark_triage_summary.py --triage-json ../docs/test_outputs/rulegen_benchmark_triage_en_de_latest.json --title \"Rulegen Benchmark Triage (en-de latest)\" --markdown-out ../docs/test_outputs/rulegen_benchmark_triage_en_de_summary_latest.md",
    "quality:rulegen:reverse:en-es": "node dev/run_python.js testing/rulegen_pair_audit_cycle.py --pairs en-es --reverse-check-profile far-hit-experiment --benchmark-json ../docs/test_outputs/rulegen_benchmark_en_es_reverse_latest.json --benchmark-markdown ../docs/test_outputs/rulegen_benchmark_en_es_reverse_latest.md --benchmark-html ../docs/test_outputs/rulegen_benchmark_en_es_reverse_latest.html --quality-gate-json ../docs/test_outputs/rulegen_quality_gate_en_es_reverse_latest.json --triage-json ../docs/test_outputs/rulegen_benchmark_triage_en_es_reverse_latest.json --triage-markdown ../docs/test_outputs/rulegen_benchmark_triage_en_es_reverse_latest.md",
    "quality:rulegen:reverse:summary": "node dev/run_python.js testing/rulegen_benchmark_summary.py --benchmark-json ../docs/test_outputs/rulegen_benchmark_en_es_reverse_latest.json --markdown-out ../docs/test_outputs/rulegen_benchmark_en_es_reverse_summary_latest.md && node dev/run_python.js testing/rulegen_quality_gate_summary.py --gate-json ../docs/test_outputs/rulegen_quality_gate_en_es_reverse_latest.json --markdown-out ../docs/test_outputs/rulegen_quality_gate_en_es_reverse_summary_latest.md && node dev/run_python.js testing/rulegen_benchmark_triage_summary.py --triage-json ../docs/test_outputs/rulegen_benchmark_triage_en_es_reverse_latest.json --markdown-out ../docs/test_outputs/rulegen_benchmark_triage_en_es_reverse_summary_latest.md",
    "quality:rulegen:reverse:matrix": "node dev/run_python.js testing/rulegen_reverse_run_matrix.py --markdown-out ../docs/test_outputs/rulegen_reverse_en_es_run_matrix_latest.md",
    "quality:rulegen:benchmark:summary": "node dev/run_python.js testing/rulegen_benchmark_summary.py --benchmark-json ../docs/test_outputs/rulegen_benchmark_en_es_latest.json --markdown-out ../docs/test_outputs/rulegen_benchmark_summary_latest.md",
    "quality:rulegen:gate": "node dev/run_python.js testing/rulegen_quality_gate.py",
    "quality:rulegen:gate:summary": "node dev/run_python.js testing/rulegen_quality_gate_summary.py --gate-json ../docs/test_outputs/rulegen_quality_gate_latest.json --markdown-out ../docs/test_outputs/rulegen_quality_gate_summary_latest.md",
    "quality:rulegen:triage": "node dev/run_python.js testing/rulegen_benchmark_triage.py",
    "quality:rulegen:triage:summary": "node dev/run_python.js testing/rulegen_benchmark_triage_summary.py --triage-json ../docs/test_outputs/rulegen_benchmark_triage_latest.json --markdown-out ../docs/test_outputs/rulegen_benchmark_triage_summary_latest.md",
    "quality:srs:harness": "node dev/run_python.js testing/srs_quality_harness.py --json-out ../docs/test_outputs/srs_quality_latest.json",
    "quality:srs:summary": "node dev/run_python.js testing/srs_quality_summary.py --quality-json ../docs/test_outputs/srs_quality_latest.json --markdown-out ../docs/test_outputs/srs_quality_summary_latest.md",
    "quality:srs:journey": "node dev/run_python.js testing/srs_journey_harness.py --json-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_latest.json",
    "quality:srs:journey:summary": "node dev/run_python.js testing/srs_journey_summary.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_ja_latest.json --markdown-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_latest.md",
    "quality:srs:journey:html": "node dev/run_python.js testing/srs_journey_html.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_ja_latest.json --html-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_latest.html",
    "quality:srs:journey:edge": "node dev/run_python.js testing/srs_journey_harness.py --scenario en-ja_edge_behaviors_v1 --json-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_edge_latest.json",
    "quality:srs:journey:edge:summary": "node dev/run_python.js testing/srs_journey_summary.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_ja_edge_latest.json --markdown-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_edge_latest.md",
    "quality:srs:journey:edge:html": "node dev/run_python.js testing/srs_journey_html.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_ja_edge_latest.json --html-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_edge_latest.html",
    "quality:srs:journey:real": "node dev/run_python.js testing/srs_journey_harness.py --scenario en-ja_real_publication_v1 --json-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_real_latest.json",
    "quality:srs:journey:real:summary": "node dev/run_python.js testing/srs_journey_summary.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_ja_real_latest.json --markdown-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_real_latest.md",
    "quality:srs:journey:real:html": "node dev/run_python.js testing/srs_journey_html.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_ja_real_latest.json --html-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_real_latest.html",
    "quality:srs:journey:installed": "node dev/run_python.js testing/srs_journey_harness.py --scenario en-ja_installed_data_journey_v1 --json-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_installed_latest.json",
    "quality:srs:journey:installed:summary": "node dev/run_python.js testing/srs_journey_summary.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_ja_installed_latest.json --markdown-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_installed_latest.md",
    "quality:srs:journey:installed:html": "node dev/run_python.js testing/srs_journey_html.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_ja_installed_latest.json --html-out ../docs/test_outputs/srs_journey/srs_journey_en_ja_installed_latest.html",
    "quality:srs:journey:en-es": "node dev/run_python.js testing/srs_journey_harness.py --scenario en-es_core_journey_v1 --json-out ../docs/test_outputs/srs_journey/srs_journey_en_es_latest.json",
    "quality:srs:journey:en-es:summary": "node dev/run_python.js testing/srs_journey_summary.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_es_latest.json --markdown-out ../docs/test_outputs/srs_journey/srs_journey_en_es_latest.md",
    "quality:srs:journey:en-es:html": "node dev/run_python.js testing/srs_journey_html.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_es_latest.json --html-out ../docs/test_outputs/srs_journey/srs_journey_en_es_latest.html",
    "quality:srs:journey:en-es:edge": "node dev/run_python.js testing/srs_journey_harness.py --scenario en-es_edge_behaviors_v1 --json-out ../docs/test_outputs/srs_journey/srs_journey_en_es_edge_latest.json",
    "quality:srs:journey:en-es:edge:summary": "node dev/run_python.js testing/srs_journey_summary.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_es_edge_latest.json --markdown-out ../docs/test_outputs/srs_journey/srs_journey_en_es_edge_latest.md",
    "quality:srs:journey:en-es:edge:html": "node dev/run_python.js testing/srs_journey_html.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_es_edge_latest.json --html-out ../docs/test_outputs/srs_journey/srs_journey_en_es_edge_latest.html",
    "quality:srs:journey:en-es:real": "node dev/run_python.js testing/srs_journey_harness.py --scenario en-es_real_publication_v1 --json-out ../docs/test_outputs/srs_journey/srs_journey_en_es_real_latest.json",
    "quality:srs:journey:en-es:real:summary": "node dev/run_python.js testing/srs_journey_summary.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_es_real_latest.json --markdown-out ../docs/test_outputs/srs_journey/srs_journey_en_es_real_latest.md",
    "quality:srs:journey:en-es:real:html": "node dev/run_python.js testing/srs_journey_html.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_es_real_latest.json --html-out ../docs/test_outputs/srs_journey/srs_journey_en_es_real_latest.html",
    "quality:srs:journey:en-es:installed": "node dev/run_python.js testing/srs_journey_harness.py --scenario en-es_installed_data_journey_v1 --json-out ../docs/test_outputs/srs_journey/srs_journey_en_es_installed_latest.json",
    "quality:srs:journey:en-es:installed:summary": "node dev/run_python.js testing/srs_journey_summary.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_es_installed_latest.json --markdown-out ../docs/test_outputs/srs_journey/srs_journey_en_es_installed_latest.md",
    "quality:srs:journey:en-es:installed:html": "node dev/run_python.js testing/srs_journey_html.py --journey-json ../docs/test_outputs/srs_journey/srs_journey_en_es_installed_latest.json --html-out ../docs/test_outputs/srs_journey/srs_journey_en_es_installed_latest.html",
    "quality:pack-sources:audit": "node dev/run_python.js testing/pack_source_url_audit.py",
    "build:bd": "node betterdiscord_plugin/build_plugin.js",
    "watch:bd": "node betterdiscord_plugin/watch_plugin.js",
    "sync:bd": "node betterdiscord_plugin/sync_plugin.js",
    "build-and-sync:bd": "node betterdiscord_plugin/build_plugin.js && node betterdiscord_plugin/sync_plugin.js"
  }
}
