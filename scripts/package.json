{
  "name": "vocab-replacer",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "check": "python3 dev/dev_workflow_check.py",
    "check:report": "python3 dev/dev_workflow_check.py --json-out ../docs/test_outputs/dev_workflow/check_latest.json",
    "check:changed": "python3 dev/dev_workflow_changed_check.py --base-ref origin/main",
    "check:changed:local": "python3 dev/dev_workflow_changed_check.py --scope local",
    "check:changed:report": "python3 dev/dev_workflow_changed_check.py --base-ref origin/main --json-out ../docs/test_outputs/dev_workflow/check_changed_latest.json",
    "check:changed:staged": "python3 dev/dev_workflow_changed_check.py --scope staged",
    "check:changed:strict-style": "python3 dev/dev_workflow_changed_check.py --base-ref origin/main --strict-style",
    "check:summary": "python3 dev/dev_workflow_summary.py --check-json ../docs/test_outputs/dev_workflow/check_latest.json --changed-json ../docs/test_outputs/dev_workflow/check_changed_latest.json --build-json ../docs/test_outputs/dev_workflow/build_latest.json --markdown-out ../docs/test_outputs/dev_workflow/summary_latest.md",
    "check:style": "python3 dev/dev_workflow_style_check.py",
    "check:style:strict": "python3 dev/dev_workflow_style_check.py --strict",
    "preflight:cws": "node dev/cws_preflight.js",
    "build": "python3 dev/dev_workflow_build.py",
    "build:report": "python3 dev/dev_workflow_build.py --json-out ../docs/test_outputs/dev_workflow/build_latest.json",
    "build:gui": "python3 build/gui_app.py --validate",
    "hooks:install": "python3 -m pre_commit install --install-hooks --config ../.pre-commit-config.yaml --hook-type pre-commit --hook-type pre-push",
    "hooks:run:pre-push": "python3 -m pre_commit run repo-safety-check --hook-stage pre-push --all-files",
    "health:project": "node dev/check_project_health.js --advisory",
    "health:project:report": "node dev/check_project_health.js --advisory --json-output ../docs/test_outputs/project_health/project_health_latest.json",
    "health:project:baseline": "node dev/check_project_health.js --advisory --write-baseline ../docs/test_outputs/project_health/project_health_baseline.json",
    "health:project:changed": "node dev/check_project_health.js --changed-only --base-ref origin/main --baseline-json ../docs/test_outputs/project_health/project_health_baseline.json --fail-on-new --fail-on-regressions",
    "quality:rulegen:audit": "python3 testing/rulegen_pair_audit_cycle.py",
    "quality:rulegen:auto": "python3 testing/rulegen_auto_audit.py --base-ref origin/main",
    "quality:rulegen:gate": "python3 testing/rulegen_quality_gate.py",
    "quality:rulegen:gate:summary": "python3 testing/rulegen_quality_gate_summary.py --gate-json ../docs/test_outputs/rulegen_quality_gate_latest.json --markdown-out ../docs/test_outputs/rulegen_quality_gate_summary_latest.md",
    "quality:rulegen:triage": "python3 testing/rulegen_benchmark_triage.py",
    "build:bd": "node betterdiscord_plugin/build_plugin.js",
    "watch:bd": "node betterdiscord_plugin/watch_plugin.js",
    "sync:bd": "node betterdiscord_plugin/sync_plugin.js",
    "build-and-sync:bd": "node betterdiscord_plugin/build_plugin.js && node betterdiscord_plugin/sync_plugin.js"
  }
}
